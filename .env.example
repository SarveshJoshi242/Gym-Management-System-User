# ═══════════════════════════════════════════════════════════════
#  GymPlus — Required Environment Variables
#  Set these on Render (or locally via your OS / IDE)
# ═══════════════════════════════════════════════════════════════

# === Database (Railway MySQL) ===
DB_URL=jdbc:mysql://<RAILWAY_HOST>:<PORT>/<DATABASE>?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_railway_password

# === Google Gemini AI ===
GEMINI_API_KEY=your_gemini_api_key

# === Frontend URL (for CORS — set to your Vercel URL) ===
FRONTEND_URL=https://your-app.vercel.app

# === Server Port ===
# Render sets this automatically — do NOT set it manually on Render
# Only needed locally if you want a non-default port
# PORT=8080
